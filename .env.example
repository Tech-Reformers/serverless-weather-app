# =============================================================================
# Serverless Weather App — Environment Variable Reference
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production, DynamoDB table names and the secret ARN are injected
# automatically by the CDK stack.  External API keys are stored in
# AWS Secrets Manager (WEATHER_API_SECRET_ARN) and NEVER placed here.
# The plain-text WEATHER_API_KEY / GEOCODING_API_KEY variables below are
# only for local development outside of AWS.
# =============================================================================

# -----------------------------------------------------------------------------
# DynamoDB Table Names
# Set automatically by the CDK stack via Lambda environment variables.
# -----------------------------------------------------------------------------
FAVORITES_TABLE_NAME=weather-app-favorites
CACHE_TABLE_NAME=weather-app-cache
PREFERENCES_TABLE_NAME=weather-app-preferences

# -----------------------------------------------------------------------------
# Secrets Manager
# Full ARN of the Secrets Manager secret that holds external API keys.
# Set automatically by the CDK stack in deployed environments.
# -----------------------------------------------------------------------------
WEATHER_API_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:weather-app/external-api-keys

# -----------------------------------------------------------------------------
# External API Endpoints
# Override to point at a sandbox / mock server during local development.
# -----------------------------------------------------------------------------
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
GEOCODING_API_URL=https://api.openweathermap.org/geo/1.0

# -----------------------------------------------------------------------------
# External API Keys — LOCAL DEVELOPMENT ONLY
# In AWS Lambda these are retrieved from Secrets Manager (see above).
# Never commit real key values to version control.
# -----------------------------------------------------------------------------
WEATHER_API_KEY=your_openweather_api_key_here
GEOCODING_API_KEY=your_geocoding_api_key_here

# -----------------------------------------------------------------------------
# Service Configuration
# These mirror the Lambda environment variables set by the CDK stack.
# -----------------------------------------------------------------------------
MAX_FAVORITES=50
DEFAULT_TEMP_UNIT=celsius
EXTERNAL_CALL_TIMEOUT_SECONDS=10
REFRESH_TIMEOUT_SECONDS=5
SEARCH_TIMEOUT_SECONDS=5
DEVICE_LOCATION_TIMEOUT_SECONDS=30
CACHE_TTL_CURRENT_MINUTES=15
CACHE_TTL_FORECAST_MINUTES=60

# -----------------------------------------------------------------------------
# AWS Configuration
# Set automatically inside Lambda; configure explicitly for local dev.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
POWERTOOLS_SERVICE_NAME=weather-app
AWS_XRAY_TRACING_NAME=weather-app
